# Copy this file to .env and fill in the values. .env is gitignored — never commit it.

# ── Microsoft Entra ID application (App Registration) ──────────────────────
TENANT_ID=<entra-tenant-id>
CLIENT_ID=<entra-app-client-id>
CLIENT_SECRET=<entra-app-client-secret>
# Scope requested at sign-in. The sso_token must be issued FOR this app
# (aud = api://<CLIENT_ID>) to be usable as an OBO assertion. Default if empty:
# api://<CLIENT_ID>/access_as_user
SSO_SCOPE=
# Code Engine URL + /auth/callback (local: http://localhost:8080/auth/callback).
# Must also be registered as a Web redirect URI in the App Registration.
REDIRECT_URI=https://<your-app>.<id>.<region>.codeengine.appdomain.cloud/auth/callback
# Any long random string (signs the session cookie)
SESSION_SECRET=<long-random-string>

# ── watsonx Orchestrate (Channels > Embedded agent snippet) ────────────────
WXO_AGENT_ID=<wxo-agent-id>
WXO_ORCHESTRATION_ID=<wxo-orchestration-id>
WXO_AGENT_ENV_ID=<wxo-agent-environment-id>
WXO_HOST_URL=https://us-south.watson-orchestrate.cloud.ibm.com
# Optional — only if present in your embed snippet
WXO_CRN=

# ── IBM Cloud deployment (used only by deploy-to-code-engine.ps1 / .sh) ────
# API key with push rights on the ICR namespace and access to the CE project.
IBMCLOUD_API_KEY=<ibm-cloud-api-key>
ICR_REGISTRY=us.icr.io
ICR_NAMESPACE=<your-icr-namespace>
IMAGE_NAME=wxo-auth-token-server
CE_REGION=eu-de
CE_RESOURCE_GROUP=<resource-group>
CE_PROJECT=<code-engine-project>
CE_APP=wxo-auth-token-server
CE_REGISTRY_SECRET=icr-secret
